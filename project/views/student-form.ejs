<%- include('partials/head') %>
<main class="container narrow">
  <div class="page-head"><h1><%= isNew ? 'Add student' : 'Edit student' %></h1></div>
  <form class="card form" method="POST" action="<%= isNew ? '/students' : '/students/' + student.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (error) { %><div class="alert bad" role="alert"><%= error %></div><% } %>
    <label>Roll number<input name="roll_no" value="<%= student.roll_no %>" maxlength="20" required></label>
    <label>Full name<input name="name" value="<%= student.name %>" maxlength="80" required></label>
    <label>Class
      <select name="class_id">
        <option value="">No class</option>
        <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= student.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
    </label>
    <div class="form-actions">
      <button class="btn" type="submit"><%= isNew ? 'Add student' : 'Save changes' %></button>
      <a class="btn ghost" href="/students">Cancel</a>
    </div>
  </form>
  <% if (!isNew) { %>
  <section class="card" style="margin-top:1rem">
    <h2>Register to a course & section</h2>
    <p class="muted small">Assign this student to a course and section. This appears on their student dashboard.</p>
    <form class="form" method="POST" action="/students/<%= student.id %>/section">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Course
        <select name="course_id" required>
          <option value="">Select a course</option>
          <% courses.forEach(function (c) { %><option value="<%= c.id %>" <%= currentSection.courseId === c.id ? 'selected' : '' %>><%= c.code %> - <%= c.name %></option><% }) %>
        </select>
      </label>
      <label>Section
        <select name="section_id" required>
          <option value="">Select a section</option>
          <% currentSection.sections.forEach(function (s) { %>
            <option value="<%= s.id %>" <%= currentSection.selectedSectionId === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </label>
      <div class="form-actions">
        <button class="btn ghost" type="submit">Save registration</button>
        <% if (currentSection.selectedSectionId) { %>
          <a class="btn danger ghost" href="/students/<%= student.id %>/section/clear" data-confirm="Remove this student's course & section registration?">Remove</a>
        <% } %>
      </div>
    </form>
  </section>
  <section class="card" style="margin-top:1rem">
    <h2>Student login</h2>
    <% if (student.user_id) { %>
      <p class="muted small">A login is linked to this student record. The student signs in at <a href="/student/login">/student/login</a>.</p>
    <% } else { %>
      <p class="muted small">The student creates their own login with a one-time registration code. A roll number alone is not enough to claim the record.</p>
      <% if (student.code_active) { %>
        <p class="muted small">A code is active until <strong><%= student.code_expires %></strong>. Generating a new code cancels the old one.</p>
      <% } %>
      <div class="form-actions">
        <form method="POST" action="/students/<%= student.id %>/registration-code">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn ghost" type="submit"><%= student.code_active ? 'Generate a new code' : 'Generate registration code' %></button>
        </form>
        <% if (student.code_active) { %>
        <form method="POST" action="/students/<%= student.id %>/registration-code/delete">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn danger ghost" type="submit">Revoke code</button>
        </form>
        <% } %>
      </div>
    <% } %>
  </section>
  <% } %>
</main>
<%- include('partials/foot') %>
