<%- include('partials/head') %>
<main class="auth">
  <form class="card login" method="POST" action="/student/register">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="button" id="themeToggle" class="icon-btn" aria-label="Toggle light or dark theme"></button>
    <div class="logo">&#10003;</div>
    <h1>Create student account</h1>
    <p class="muted">Sign up to access your dashboard</p>
    <% if (error) { %><div class="alert bad" role="alert"><%= error %></div><% } %>
    <label>Name<input type="text" name="name" required autocomplete="name"></label>
    <label>Email<input type="email" name="email" required autocomplete="username" autofocus></label>
    <label>Password<input type="password" name="password" required autocomplete="current-password" minlength="8"></label>
    <label>Class
      <select name="class_id" required>
        <option value="">Select your class</option>
        <% classes.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
    </label>
    <label>Roll number<input type="text" name="roll_no" required autocomplete="roll-number"></label>
    <button class="btn lg" type="submit">Register</button>
  </form>
</main>
<%- include('partials/foot') %>