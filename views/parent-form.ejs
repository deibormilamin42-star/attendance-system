<%- include('partials/head') %>
<main class="container narrow">
  <div class="page-head"><h1>Parent / guardian - <%= student.roll_no %> <%= student.name %></h1></div>
  <form class="card form" method="POST" action="/parents/<%= student.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (error) { %><div class="alert bad" role="alert"><%= error %></div><% } %>
    <label>Parent / guardian name<input name="name" value="<%= parent.name %>" maxlength="80" required></label>
    <label>Email<input type="email" name="email" value="<%= parent.email %>" maxlength="120"></label>
    <label>Phone<input type="text" name="phone" value="<%= parent.phone %>" maxlength="30"></label>
    <div class="form-actions">
      <button class="btn" type="submit">Save</button>
      <a class="btn ghost" href="/parents">Back</a>
    </div>
  </form>

  <section class="card" style="margin-top:1rem">
    <h2>Send a message</h2>
    <p class="muted small">Write a message to the parent. On a real deployment this would use an email/SMS provider.</p>
    <form class="form" method="POST" action="/parents/<%= student.id %>/message">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Subject<input name="subject" maxlength="120" placeholder="e.g. Attendance alert" required></label>
      <label>Message<textarea name="body" maxlength="2000" rows="6" required></textarea></label>
      <label>Channel
        <select name="channel">
          <option value="email">Email</option>
          <option value="sms">SMS</option>
          <option value="both">Both</option>
        </select>
      </label>
      <div class="form-actions"><button class="btn" type="submit">Send message</button></div>
    </form>
  </section>
</main>
<%- include('partials/foot') %>
