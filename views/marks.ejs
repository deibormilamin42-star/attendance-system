<%- include('partials/head') %>
<main class="container">
  <div class="page-head">
    <h1>Marks</h1>
    <% if (user.role === 'admin') { %>
    <form class="card filters" method="POST" action="/marks/calculate" style="margin-bottom:1rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Class
        <select name="class_id">
          <option value="">All students</option>
          <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= classId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </label>
      <label>As of date<input type="date" name="as_of" value="<%= today %>"></label>
      <button class="btn" type="submit">Calculate marks</button>
    </form>
    <% } %>
  </div>

  <form class="card filters" method="GET" action="/marks">
    <label>Class
      <select name="class_id">
        <option value="">All classes</option>
        <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= classId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
    </label>
    <label>Student
      <select name="student_id">
        <option value="">All students</option>
        <% rows.forEach(function (r) { %><option value="<%= r.student_id %>" <%= studentId === r.student_id ? 'selected' : '' %>><%= r.roll_no %> - <%= r.name %></option><% }) %>
      </select>
    </label>
    <button class="btn" type="submit">Filter</button>
  </form>

  <section class="card">
    <% if (!rows.length) { %>
      <p class="muted">No marks yet. Calculate marks above to see results.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Roll</th><th>Name</th><th>Class</th><th class="num">Attendance %</th><th class="num">Marks</th><th>Calculated on</th></tr></thead>
          <tbody>
            <% rows.forEach(function (r) { %>
              <tr>
                <td><%= r.roll_no %></td>
                <td><a href="/students/<%= r.student_id %>"><%= r.name %></a></td>
                <td><%= r.class_name || '–' %></td>
                <td class="num"><%= r.attendance_pct %>%</td>
                <td class="num"><span class="chip <%= r.marks >= LOW ? 'present' : 'absent' %>"><%= r.marks %>/100</span></td>
                <td><%= pretty(r.calculated_on) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small">Marks are automatically derived from attendance percentage up to the calculated-on date (marks = attendance %).</p>
    <% } %>
  </section>
</main>
<%- include('partials/foot') %>
